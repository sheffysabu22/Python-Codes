a = float(input("First number: "))
op = input("operator (+ - * /): ")
b = float(input("Second number: "))

result = None
if op == "+":
    result = a + b
elif op == "-":
    result = a - b
elif op == "*":
    result = a * b
elif op == "/":
    if b != 0:
        result = a / b
    else:
        result = "Error (division by zero)"
else:
    result = "Error (invalid operator)"

print(f"{a} {op} {b} = {result}")

